# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars — it is gitignored.

# ── AWS ────────────────────────────────────────────────────────────────────────
AWS_REGION = "eu-central-1"

# ── Domain ────────────────────────────────────────────────────────────────────
domain_name = "mlplatform.example.com"

# ── Feature flags ────────────────────────────────────────────────────────────
deploy_airflow    = true
deploy_mlflow     = true
deploy_jupyterhub = true
deploy_monitoring = true
deploy_sagemaker  = true
deploy_dashboard  = true

# ── Git / DAG sync ────────────────────────────────────────────────────────────
git_sync_repository_url = "https://github.com/your-org/mlops-airflow-DAGs.git"
git_sync_branch         = "main"
git_username            = "your-github-username"
git_token               = "ghp_xxxxxxxxxxxxxxxxxxxx"

# ── Airflow ───────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
airflow_fernet_key = ""

# GitHub OAuth app for Airflow webserver auth
airflow_git_client_id     = ""
airflow_git_client_secret = ""

# ── JupyterHub ────────────────────────────────────────────────────────────────
jupyterhub_git_client_id     = ""
jupyterhub_git_client_secret = ""
# Generate with: openssl rand -hex 32
jupyterhub_proxy_secret_token = ""

# ── Grafana ───────────────────────────────────────────────────────────────────
grafana_git_client_id     = ""
grafana_git_client_secret = ""
